#include <behaviors.dtsi>  // https://zmk.dev/docs/development/new-behavior
#include <dt-bindings/zmk/keys.h>  // https://zmk.dev/docs/keymaps
#include <dt-bindings/zmk/bt.h>  // https://zmk.dev/docs/keymaps/behaviors/bluetooth
#include <dt-bindings/zmk/rgb.h>  // https://zmk.dev/docs/keymaps/behaviors/underglow
#include <dt-bindings/zmk/ext_power.h>  // https://zmk.dev/docs/keymaps/behaviors/power
#include <dt-bindings/zmk/outputs.h>  // https://zmk.dev/docs/keymaps/behaviors/outputs
#include <dt-bindings/led/led.h>  // https://zmk.dev/docs/features/underglow
#include <dt-bindings/zmk/rgb_layer_colors.h>  // fork : effet "couleurs par layer" (RGB_TRANS)

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <29>; /* arbitrary; change at will */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};



&nice_view_spi {
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
};




#define BASE 0
#define SETTINGS 1
#define SYMBOLS 2
#define SHORTCUTS 3
#define NUMPAD 4
#define EXTRAS 5
#define BOARD 6

// &led_strip { chain-length = <29>; };
&sensors { triggers-per-rotation = <30>; };

/ {
    behaviors {
        TD: TD {
            compatible = "zmk,behavior-hold-tap";
            label = "TD";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
			quick-tap-ms = <125>;
            flavor = "tap-preferred";
        };

        TTH__LGUI_SYMBL: TTH__LGUI_SYMBL {
            compatible = "zmk,behavior-tap-dance";
            label = "TTH__LGUI_SYMBL";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&mo 2>;
        };

        TTH__RCTL_SHRTCT: TTH__RCTL_SHRTCT {
            compatible = "zmk,behavior-tap-dance";
            label = "TTH__RCTL_SHRTCT";
            #binding-cells = <0>;
            bindings = <&kp RCTRL>, <&mo 3>;
        };
		
		rgb_r: set_underglow_to_red {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(0, 100, 50)>;
		};
		
		rgb_g: set_underglow_to_green {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(128, 100, 50)>;
		};
		
		rgb_b: set_underglow_to_blue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(232, 100, 50)>;
		};
		
		rgb_w: set_underglow_to_white {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(160, 0, 50)>;
		};
		
		rgb_p1: set_underglow_to_preset1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(10, 100, 50)>;
		};
		
		rgb_p2: set_underglow_to_preset2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(50, 100, 50)>;
		};
		
		rgb_p3: set_underglow_to_preset3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(160, 100, 50)>;
		};
		
		rgb_p4: set_underglow_to_preset4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(290, 100, 50)>;
		};
		
		rgb_p5: set_underglow_to_preset5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &rgb_ug RGB_COLOR_HSB(10, 100, 10)>;
		};
    };



/*
 * Couleurs par touche pour l'effet "couleurs par layer" (effet 4, fork ZMK
 * TheOnlyOneAkira/zmk branche sofle-layer-colors).
 * - Même disposition que les bindings du keymap (60 positions ; les deux
 *   emplacements des clics d'encodeur n'ont pas de LED, la valeur est ignorée).
 * - Le layer actif le plus haut qui définit une couleur l'emporte ;
 *   ___ (RGB_TRANS) laisse voir la couleur du layer en dessous.
 * - Une touche sans couleur sur aucun layer actif reste éteinte.
 * - Couleurs en 0xRRGGBB ; la luminosité globale (RGB_BRI / RGB_BRD) s'applique.
 *   La teinte (RGB_HUI, &rgb_p1...) n'a pas d'effet sur cet effet.
 */
#define ___ RGB_TRANS
#define OFF 0x000000
#define WHT 0xFFFFFF
#define RED 0xFF0000
#define GRN 0x00FF00
#define BLU 0x0000FF
#define CYN 0x00FFFF
#define PUR 0x8000FF
#define ORG 0xFF6000
#define YEL 0xFFC000
// Aperçu des presets &rgb_p1 ... &rgb_p5 (layer NUMPAD)
#define P1C 0xFF2A00
#define P2C 0xFFD400
#define P3C 0x00FFAA
#define P4C 0xD400FF
#define P5C 0x330800

    underglow_layer_colors {
        compatible = "zmk,underglow-layer-colors";

        base_colors {
            layer = <BASE>;
            colors = <
PUR CYN CYN CYN CYN CYN                 CYN CYN CYN CYN CYN PUR
PUR WHT WHT WHT WHT WHT                 WHT WHT WHT WHT WHT PUR
PUR WHT WHT WHT WHT WHT                 WHT WHT WHT WHT WHT PUR
PUR WHT WHT WHT WHT WHT ___         ___ WHT WHT WHT WHT WHT PUR
        PUR ORG ORG BLU BLU         BLU BLU ORG ORG PUR
            >;
        };

        // Bleu : sélection BT, cyan : déconnexion BT, rouge : BT_CLR, blanc : médias
        settings_colors {
            layer = <SETTINGS>;
            colors = <
BLU BLU BLU BLU BLU OFF                 OFF OFF OFF OFF OFF OFF
CYN CYN CYN CYN CYN OFF                 OFF OFF WHT OFF OFF OFF
___ OFF OFF OFF OFF OFF                 OFF WHT WHT WHT OFF OFF
RED OFF OFF OFF OFF OFF OFF         OFF OFF OFF OFF OFF ___ ___
        ___ ___ ___ ___ ___         ___ ___ ___ ___ ___
            >;
        };

        // Vert : F1-F12 et symboles, violet : accès au layer EXTRAS
        symbols_colors {
            layer = <SYMBOLS>;
            colors = <
___ GRN GRN GRN GRN GRN                 GRN GRN GRN GRN GRN GRN
___ OFF OFF OFF OFF OFF                 GRN GRN GRN GRN GRN GRN
___ OFF OFF OFF OFF OFF                 GRN GRN GRN GRN GRN ___
___ OFF OFF GRN GRN GRN ___         ___ GRN GRN GRN GRN GRN ___
        OFF OFF PUR OFF ___         ___ ___ ___ ___ ___
            >;
        };

        // Jaune : raccourcis et navigation, blanc : flèches, violet : accès au layer EXTRAS
        shortcuts_colors {
            layer = <SHORTCUTS>;
            colors = <
___ ___ ___ ___ ___ ___                 ___ ___ ___ ___ ___ YEL
___ YEL YEL YEL OFF YEL                 YEL YEL WHT YEL ___ YEL
___ OFF OFF OFF OFF OFF                 YEL WHT WHT WHT YEL YEL
OFF YEL YEL YEL YEL OFF ___         ___ OFF YEL OFF YEL YEL YEL
        ___ ___ ___ ___ ___         ___ PUR ___ ___ ___
            >;
        };

        // Cyan : réglages RGB, presets dans leur couleur, blanc : chiffres, orange : opérateurs
        numpad_colors {
            layer = <NUMPAD>;
            colors = <
CYN OFF OFF CYN CYN CYN                 ORG OFF OFF OFF OFF OFF
OFF OFF OFF CYN CYN CYN                 ORG WHT WHT WHT OFF ORG
CYN OFF OFF CYN CYN CYN                 ORG WHT WHT WHT OFF OFF
WHT OFF OFF OFF OFF OFF ___         ___ ORG WHT WHT WHT OFF OFF
        P1C P2C P3C P4C P5C         ORG ORG WHT ORG ORG
            >;
        };

        // Violet : changement de bureau et ext_power, rouge : accès au layer BOARD
        extras_colors {
            layer = <EXTRAS>;
            colors = <
RED OFF OFF OFF OFF OFF                 OFF OFF OFF OFF OFF RED
OFF OFF OFF OFF OFF OFF                 OFF OFF OFF OFF OFF OFF
OFF OFF OFF OFF OFF OFF                 OFF PUR OFF PUR OFF OFF
OFF OFF OFF OFF OFF OFF OFF         OFF OFF OFF OFF OFF OFF OFF
        OFF OFF OFF OFF PUR         PUR OFF OFF OFF OFF
            >;
        };

        // Rouge : bootloader, orange : reset
        board_colors {
            layer = <BOARD>;
            colors = <
OFF OFF OFF OFF OFF RED                 RED OFF OFF OFF OFF OFF
OFF OFF OFF OFF OFF ORG                 ORG OFF OFF OFF OFF OFF
OFF OFF OFF OFF OFF OFF                 OFF OFF OFF OFF OFF OFF
OFF OFF OFF OFF OFF OFF OFF         OFF OFF OFF OFF OFF OFF OFF
        OFF OFF OFF OFF OFF         OFF OFF OFF OFF OFF
            >;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
			bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3            &kp N4  &TD 1 N5                                   &TD 1 NUMBER_6  &kp N7  &kp N8             &kp N9         &kp N0    &kp GRAVE
&TD 4 TAB       &kp Q   &kp W     &kp E             &kp R   &kp T                                      &kp Y           &kp U   &kp I              &kp O          &kp P     &kp BSPC
&kp LEFT_SHIFT  &kp A   &kp S     &kp D             &kp F   &kp G                                      &kp H           &kp J   &kp K              &kp L          &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X     &kp C             &kp V   &kp B      &kp C_PLAY_PAUSE    &kp C_MUTE  &kp N           &kp M   &kp COMMA          &kp DOT        &kp FSLH  &kp RSHFT
                        &kp LALT  &TTH__LGUI_SYMBL  &mo 3   &kp SPACE  &kp RET             &kp ENTER   &kp SPACE       &mo 2   &TTH__RCTL_SHRTCT  &kp RIGHT_ALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        SETTINGS {
            display-name = "SETTINGS";
			bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                     &none   &none           &none              &none       &none   &none
&bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &none                     &none   &none           &kp C_VOL_UP       &none       &none   &none
&trans        &none         &none         &none         &none         &none                     &none   &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_NEXT  &none   &none
&bt BT_CLR    &none         &none         &none         &none         &none   &none     &none   &none   &none           &none              &none       &trans  &trans
                            &trans        &trans        &trans        &trans  &trans    &trans  &trans  &trans          &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        SYMBOLS {
            display-name = "SYMBOLS";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3         &kp F4           &kp F5                       &kp F6     &kp F7           &kp F8         &kp F9        &kp F10       &kp F11
&trans  &none   &none   &none          &none            &none                        &kp N5     &kp LC(RA(N5))   &kp RA(N4)     &kp LS(LBKT)  &kp RA(E)     &kp F12
&trans  &none   &none   &none          &none            &none                        &kp MINUS  &kp RA(MINUS)    &kp RA(EQUAL)  &kp LBKT      &kp RBKT      &trans
&trans  &none   &none   &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp EQUAL  &trans    &trans  &kp EQUAL  &kp KP_PLUS      &kp KP_MINUS   &kp BSLH      &kp LS(RBKT)  &trans
                &none   &none          &mo 5            &none      &trans    &trans  &trans     &trans           &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        SHORTCUTS {
            display-name = "SHORTCUT";
            bindings = <
&trans  &trans    &trans           &trans             &trans     &trans                              &trans         &trans        &trans        &trans         &trans    &kp DELETE
&trans  &kp INS   &kp PRINTSCREEN  &kp K_APPLICATION  &none      &kp LC(KP_SLASH)                    &kp PAGE_UP    &kp LC(LEFT)  &kp UP_ARROW  &kp LC(RIGHT)  &trans    &kp BACKSPACE
&trans  &none     &none            &none              &none      &none                               &kp PAGE_DOWN  &kp LEFT      &kp DOWN      &kp RIGHT      &kp DEL   &kp BACKSPACE
&none   &kp NUBS  &kp LC(X)        &kp LC(C)          &kp LC(V)  &none             &trans    &trans  &none          &kp HOME      &none         &kp END        &kp NUBS  &kp CAPSLOCK
                  &trans           &trans             &trans     &trans            &trans    &trans  &trans         &mo 5         &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        NUMPAD {
            display-name = "NUMPAD";
            bindings = <
&rgb_ug RGB_ON   &none  &none   &rgb_ug RGB_EFR &rgb_ug RGB_TOG &rgb_ug RGB_EFF                          &kp KP_PLUS      &none            &none            &none            &none  &none
&none            &none  &none   &rgb_ug RGB_SAD &rgb_ug RGB_BRI &rgb_ug RGB_SAI                          &kp KP_SUBTRACT  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none  &kp BACKSPACE
&rgb_ug RGB_OFF  &none  &none   &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_HUI                          &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none  &none
&rgb_w           &none  &none   &none           &none           &none            &trans       &trans     &kp KP_ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &none
						&rgb_p1 &rgb_p2         &rgb_p3         &rgb_p4          &rgb_p5      &kp ENTER  &kp SPACE        &kp KP_NUMBER_0  &kp KP_EQUAL     &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        EXTRAS {
            display-name = "EXTRAS";
            bindings = <
&mo 6  &none  &none  &none  &none  &none                                          &none  &none             &none  &none              &none  &mo 6
&none  &none  &none  &none  &none  &none                                          &none  &none             &none  &none              &none  &none
&none  &none  &none  &none  &none  &none                                          &none  &kp LC(LG(LEFT))  &none  &kp LC(LG(RIGHT))  &none  &none
&none  &none  &none  &none  &none  &none  &none                &none              &none  &none             &none  &none              &none  &none
              &none  &none  &none  &none  &ext_power EP_TOG    &ext_power EP_TOG  &none  &none             &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        BOARD {
            display-name = "BOARD";
            bindings = <
&none  &none  &none  &none  &none  &bootloader                  &bootloader  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &sys_reset                   &sys_reset   &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                        &none        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none        &none    &none  &none        &none  &none  &none  &none  &none
              &none  &none  &none  &none        &none    &none  &none        &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };
    };
};
